# ── Credentials (NEVER commit) ────────────────────────────────────────────────
.env

# ── Python / Virtual Env (not needed with Docker, but just in case) ───────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── ChromaDB persistent data ──────────────────────────────────────────────────
q2_knowledge_base/chroma_db/

