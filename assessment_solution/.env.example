# OpenAI (required for embeddings, KB retrieval response, Q1/Q4 LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Vapi.ai (required for Q1 and Q3 voice agents)
VAPI_PRIVATE_API_KEY=your_vapi_private_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Deepgram (required for Q4 streaming ASR; also used in Vapi for Q1/Q3)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs (optional TTS override; Vapi handles TTS by default)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Service URLs (set after deploying)
KB_RETRIEVAL_URL=http://localhost:8001
KB_WEBHOOK_URL=http://localhost:8002
